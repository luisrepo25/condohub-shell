# Keycloak (realm condohub). El cliente `condohub-spa` es público y usa Authorization Code + PKCE.
VITE_KEYCLOAK_ISSUER=http://localhost:8180/realms/condohub
VITE_KEYCLOAK_CLIENT_ID=condohub-spa
# Remotos (micro frontends). Cada uno exporta mount(el, { getToken, user }) y unmount(el).
VITE_REMOTE_ADMIN=http://localhost:4200/remoteEntry.js
VITE_REMOTE_RESIDENTE=http://localhost:5174/assets/remoteEntry.js
VITE_REMOTE_GUARDIA=http://localhost:5175/assets/remoteEntry.js